# Local LLM served by Ollama (https://ollama.com). Pull the model first: ollama pull qwen3:4b
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
# Seconds to wait for one model response (CPU inference is slow).
LLM_TIMEOUT=300
# Set to 0 to stop saving prompts/responses to data/finetune/interactions.jsonl
LLM_LOG_INTERACTIONS=1

# Whisper size: tiny | base | small | medium  (small = better accuracy, base = faster)
WHISPER_MODEL=small

PORT=8000
FRONTEND_ORIGIN=*
